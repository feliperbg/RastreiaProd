<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Adicionar Nova Etapa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 500px;
            margin-top: 50px;
        }

        .form-label {
            font-weight: 600;
            color: #495057;
        }

        .form-control,
        .form-select {
            border-radius: 5px;
            box-shadow: none;
            padding: 0.8rem 1rem;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.25rem rgba(38, 143, 255, 0.25);
        }

        .btn-primary {
            border-radius: 5px;
            padding: 0.6rem 1.5rem;
            font-weight: bold;
        }

        .btn-secondary {
            background-color: #ff0000;
            border-color: #ff0000b9;
            border-radius: 5px;
            padding: 0.6rem 1.5rem;
            font-weight: bold;
        }

        .btn-secondary:hover {
            background-color: #ff0000;
            border-color: #ff0000b9;
        }

        .mb-3 {
            margin-bottom: 1rem;
        }
    </style>
</head>

<body>
    <div class="container mt-5" style="max-width: 600px;">
        <h1>Adicionar Nova Etapa</h1>
        <form id="form-adicionar-etapa">
            <div class="mb-3">
                <label for="nome" class="form-label">Nome da Etapa</label>
                <input type="text" id="nome" class="form-control" required />
            </div>
            <div class="mb-3">
                <label for="sequencias" class="form-label">Sequência</label>
                <input type="number" id="sequencias" class="form-control" required min="1" />
            </div>
            <div class="mb-3">
                <label class="form-label">Departamento Responsável</label>
                <div class="input-group">
                    <input type="text" id="departamentoResponsavel" class="form-control" placeholder="Nenhum" readonly />
                    <button type="button" class="btn btn-outline-secondary" id="btnSelecionarDepartamentoResponsavel">Selecionar</button>
                </div>
            </div>
            <div class="mb-3">
                <label for="procedimentos" class="form-label">Procedimentos</label>
                <textarea id="procedimentos" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Componentes de Conclusão</label>
                <div class="input-group">
                    <input type="text" id="componentesConclusao" class="form-control" placeholder="Nenhum componente selecionado" readonly />
                    <button type="button" class="btn btn-outline-secondary" id="btnSelecionarComponentesConclusao">Selecionar</button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Funcionários Responsáveis</label>
                <div class="input-group">
                    <input type="text" id="funcionariosResponsaveis" class="form-control" placeholder="Nenhum" readonly />
                    <button type="button" class="btn btn-outline-secondary" id="btnSelecionarFuncionarios">Selecionar</button>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Etapa</button>
            <button type="button" class="btn btn-secondary">Cancelar</button>
        </form>
    </div>
    <%- include('../partials/toast.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/toast.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pathParts = window.location.pathname.split('/');
            const produtoId = pathParts[pathParts.length - 2];

            // --- ESTRUTURA DE DADOS ---
            let componentesConclusaoSelecionados = [];
            let funcionariosSelecionadosIds = [];
            let departamentoResponsavelId = null;
            let listaCompletaComponentes = [];
            let listaCompletaFuncionarios = [];
            let listaCompletaDepartamentos = [];

            if (!produtoId.match(/^[0-9a-fA-F]{24}$/)) {
                exibirMensagem('Erro!', 'ID do produto inválido na URL.', 'error');
                document.getElementById('form-adicionar-etapa').style.display = 'none';
                return;
            }
            
            async function buscarProximaSequencia() {
                try {
                    const response = await fetch(`/api/etapas/produtos/${produtoId}/proxima-sequencia`, {
                        headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
                    });
                    if (!response.ok) throw new Error('Não foi possível obter a próxima sequência.');

                    const data = await response.json();
                    if (data.status) {
                        document.getElementById('sequencias').value = data.proximaSequencia;
                    }
                } catch (error) {
                    console.error('Erro ao buscar próxima sequência:', error);
                    exibirMensagem("Atenção", "Não foi possível sugerir um número de sequência.", "warning");
                }
            }

            buscarProximaSequencia();

            document.querySelector('.btn-secondary').onclick = () => {
                window.location.href = `/etapas/produtos/${produtoId}`;
            };

            async function carregarListasCompletas() {
                if (listaCompletaComponentes.length > 0 && listaCompletaFuncionarios.length > 0 && listaCompletaDepartamentos.length > 0) return;
                try {
                    const [produtoRes, funcRes, departamentoRes] = await Promise.all([
                        fetch(`/api/produtos/${produtoId}`, { headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` } }),
                        fetch('/api/funcionarios', { headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` } }),
                        fetch('/api/departamentos', { headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` } }),
                    ]);
                    if (!produtoRes.ok || !funcRes.ok || !departamentoRes.ok) throw new Error("Falha ao carregar dados.");

                    const produtoJson = await produtoRes.json();
                    const funcJson = await funcRes.json();
                    const depJson = await departamentoRes.json();

                    listaCompletaDepartamentos = depJson.departamentos || [];
                    listaCompletaComponentes = produtoJson.produto.componentesNecessarios.map(c => c.componente) || [];
                    listaCompletaFuncionarios = funcJson.funcionarios || [];

                } catch (error) {
                    console.error("Erro em carregarListasCompletas:", error);
                    exibirMensagem("Não foi possível carregar as opções de seleção.", "erro");
                }
            }

            function atualizarDisplayComponentesConclusao() {
                const input = document.getElementById('componentesConclusao');
                if (componentesConclusaoSelecionados.length === 0) {
                    input.value = '';
                    return;
                }
                const nomes = componentesConclusaoSelecionados.map(sel => {
                    const comp = listaCompletaComponentes.find(c => c._id === sel.componente);
                    return `${comp ? comp.nome : 'Desconhecido'} (Qtd: ${sel.quantidade})`;
                });
                input.value = nomes.join(', ');
            }

            document.getElementById('btnSelecionarComponentesConclusao').addEventListener('click', async function () {
                await carregarListasCompletas();
                const idsAtuais = componentesConclusaoSelecionados.map(c => c.componente);
                const selecaoResult = await selecionarMultiplos('Selecionar Componentes de Conclusão', listaCompletaComponentes, idsAtuais);

                if (selecaoResult.isConfirmed) {
                    const novosIdsSelecionados = selecaoResult.value;
                    const novosComponentesInfo = [];
                    let processoCancelado = false;

                    for (const id of novosIdsSelecionados) {
                        const componente = listaCompletaComponentes.find(c => c._id === id);
                        if (!componente) continue;

                        const componenteExistente = componentesConclusaoSelecionados.find(c => c.componente === id);
                        const quantidadeSugerida = componenteExistente ? componenteExistente.quantidade : 1;

                        const quantidadeResult = await Swal.fire({
                            title: `Quantidade para ${componente.nome}`,
                            input: 'number',
                            inputValue: quantidadeSugerida,
                            inputAttributes: { min: 1 },
                            showCancelButton: true,
                            confirmButtonText: 'Próximo →',
                            cancelButtonText: 'Cancelar processo',
                            inputValidator: (value) => !value || parseInt(value, 10) < 1 ? 'Insira uma quantidade válida (mínimo 1)' : null
                        });

                        if (quantidadeResult.isConfirmed && quantidadeResult.value) {
                            novosComponentesInfo.push({
                                componente: id,
                                quantidade: parseInt(quantidadeResult.value, 10),
                                nome: componente.nome
                            });
                        } else {
                            processoCancelado = true;
                            break;
                        }
                    }

                    if (!processoCancelado) {
                        componentesConclusaoSelecionados = novosComponentesInfo;
                        atualizarDisplayComponentesConclusao();
                        exibirMensagem('Componentes de conclusão adicionados!', 'sucesso');
                    }
                }
            });

            document.getElementById('btnSelecionarFuncionarios').addEventListener('click', async function () {
                await carregarListasCompletas();
                const result = await selecionarMultiplos('Selecionar Funcionários', listaCompletaFuncionarios, funcionariosSelecionadosIds);
                if (result.isConfirmed) {
                    funcionariosSelecionadosIds = result.value;
                    const nomes = listaCompletaFuncionarios
                        .filter(f => funcionariosSelecionadosIds.includes(f._id))
                        .map(f => f.nome);
                    document.getElementById('funcionariosResponsaveis').value = nomes.join(', ');
                }
            });

            document.getElementById('btnSelecionarDepartamentoResponsavel').addEventListener('click', async function () {
                await carregarListasCompletas();
                const result = await selecionarUnico('Selecione o Departamento Responsável', listaCompletaDepartamentos, departamentoResponsavelId);
                if (result.isConfirmed && result.value) {
                    departamentoResponsavelId = result.value;
                    const departamento = listaCompletaDepartamentos.find(d => d._id === departamentoResponsavelId);
                    document.getElementById('departamentoResponsavel').value = departamento ? departamento.nome : '';
                }
            });

            document.getElementById('form-adicionar-etapa').addEventListener('submit', async function (event) {
                event.preventDefault();

                const dadosNovaEtapa = {
                    nome: document.getElementById('nome').value,
                    sequencias: parseInt(document.getElementById('sequencias').value, 10),
                    departamentoResponsavel: departamentoResponsavelId,
                    procedimentos: document.getElementById('procedimentos').value,
                    componentesConclusao: componentesConclusaoSelecionados,
                    funcionariosResponsaveis: funcionariosSelecionadosIds,
                    produto: produtoId
                };

                if (!dadosNovaEtapa.nome || !dadosNovaEtapa.sequencias) {
                    return exibirMensagem("Nome e Sequência são obrigatórios.", "erro");
                }

                try {
                    const response = await fetch('/api/etapas', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('authToken')}` },
                        body: JSON.stringify(dadosNovaEtapa)
                    });
                    const result = await response.json();
                    if (!response.ok) {
                        throw new Error(result.msg || "Erro desconhecido ao criar a etapa.");
                    }

                    exibirMensagem('Etapa adicionada com sucesso!', 'sucesso');
                    setTimeout(() => {
                        window.location.href = `/etapas/produtos/${produtoId}`;
                    }, 1500);
                } catch (error) {
                    exibirMensagem("Erro", error.message, "error");
                }
            });

            async function selecionarMultiplos(titulo, lista, selecionados) {
                return Swal.fire({
                    title: titulo,
                    html: `
                        <input type="text" id="swal-filtro" class="form-control mb-2" placeholder="Filtrar por nome...">
                        <div id="swal-lista" style="max-height: 300px; overflow-y: auto; text-align: left; border: 1px solid #ddd; padding: 10px; border-radius: 5px;">
                            ${lista.map(item => `
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="swal-${item._id}" value="${item._id}" ${selecionados.includes(item._id) ? 'checked' : ''}>
                                    <label class="form-check-label" for="swal-${item._id}">
                                        ${item.nome}
                                    </label>
                                </div>
                            `).join('')}
                        </div>`,
                    showCancelButton: true,
                    confirmButtonText: 'Confirmar Seleção',
                    cancelButtonText: 'Cancelar',
                    width: '500px',
                    preConfirm: () => {
                        const checkedBoxes = document.querySelectorAll('#swal-lista input[type=checkbox]:checked');
                        return Array.from(checkedBoxes).map(cb => cb.value);
                    },
                    didOpen: () => {
                        const filtro = document.getElementById('swal-filtro');
                        filtro.addEventListener('input', function() {
                            const termoBusca = this.value.toLowerCase();
                            document.querySelectorAll('#swal-lista .form-check').forEach(div => {
                                const label = div.querySelector('label');
                                const nomeItem = label.textContent.toLowerCase();
                                div.style.display = nomeItem.includes(termoBusca) ? '' : 'none';
                            });
                        });
                        filtro.focus();
                    }
                });
            }

            async function selecionarUnico(titulo, lista, selecionadoId) {
                const inputOptions = {};
                lista.forEach(item => {
                    inputOptions[item._id] = item.nome;
                });

                return Swal.fire({
                    title: titulo,
                    input: 'select',
                    inputOptions: inputOptions,
                    inputValue: selecionadoId,
                    showCancelButton: true,
                    confirmButtonText: 'Selecionar',
                    cancelButtonText: 'Cancelar',
                });
            }

            carregarListasCompletas();
        });
    </script>
</body>

</html>