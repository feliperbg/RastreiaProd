<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Editar Funcionário</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; font-family: Arial, sans-serif; }
        .container { max-width: 600px; margin-top: 50px; }
        .form-label { font-weight: 600; color: #495057; }
        .form-control, .form-select { border-radius: 5px; box-shadow: none; }
        .form-control:focus, .form-select:focus { border-color: #007bff; box-shadow: 0 0 0 0.25rem rgba(38, 143, 255, 0.25); }
        .btn-primary, .btn-secondary { border-radius: 5px; padding: 0.6rem 1.5rem; font-weight: bold; }
    </style>
</head>
<body class="p-3">
    <div class="container">
        <h1>Editar Funcionário</h1>
        <form id="form-editar">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="nome" class="form-label">Nome Completo</label>
                    <input type="text" id="nome" name="nome" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" id="email" name="email" class="form-control" required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="CPF" class="form-label">CPF</label>
                    <input type="text" id="CPF" name="CPF" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="telefone" class="form-label">Telefone</label>
                    <input type="text" id="telefone" name="telefone" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="dataNascimento" class="form-label">Data de Nascimento</label>
                    <input type="date" id="dataNascimento" name="dataNascimento" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="turno" class="form-label">Turno</label>
                    <select id="turno" name="turno" class="form-select">
                        <option value="Manhã">Manhã</option>
                        <option value="Tarde">Tarde</option>
                        <option value="Noite">Noite</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="role" class="form-label">Nível de Acesso (Role)</label>
                    <select id="role" name="role" class="form-select">
                        <option value="administrador">Administrador</option>
                        <option value="funcionario">Funcionário</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="departamento" class="form-label">Departamento</label>
                    <select id="departamento" name="departamento" class="form-select">
                        <option value="">Selecione um departamento</option>
                        <!-- Opções carregadas via JS -->
                    </select>
                </div>
            </div>

            <!-- <div class="mb-3">
                <label class="form-label">Permissões</label>
                <div class="border p-2 rounded" id="permissoes-container">
                    
                </div>
            </div> -->
            
            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            <button type="button" class="btn btn-secondary" onclick="window.location.href='/funcionarios'">Cancelar</button>
        </form>
    </div>
    
    <%- include('../partials/toast.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.6/dist/inputmask.min.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/funcionario.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const pathParts = window.location.pathname.split('/');
            const id = pathParts[pathParts.length - 2];
            if (!id) {
                exibirMensagem('ID do funcionário não encontrado na URL!', 'erro');
                return;
            }

            // Aplica as máscaras de formatação
            Inputmask("999.999.999-99").mask(document.getElementById('CPF'));
            Inputmask("(99) 99999-9999").mask(document.getElementById('telefone'));

            // Lista de todas as permissões possíveis no sistema
            // const todasAsPermissoes = [
            //     { value: 'editar_conteudos', label: 'Editar Conteúdo' },
            //     { value: 'excluir_conteudos', label: 'Excluir Conteúdo' },
            //     { value: 'gerenciar_usuarios', label: 'Gerenciar Usuários' },
            //     { value: 'gerar_relatorios', label: 'Gerar Relatórios' },
            //     { value: 'visualizar_dados', label: 'Visualizar Dados' },
            //     { value: 'configurar_sistema', label: 'Configurar Sistema' }
            // ];

            /**
             * Carrega os dados do funcionário e preenche o formulário.
             */
            async function carregarDadosFuncionario() {
                // Inicia as duas requisições em paralelo para mais eficiência
                const deptoPromise = fetch('/api/departamentos', {
                    method: 'GET',
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
                }).then(res => res.json());

                const funcPromise = fetch(`/api/funcionarios/${id}`, {
                    method: 'GET',
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
                }).then(res => res.json());

                try {
                    // Aguarda a conclusão de ambas as requisições
                    const [deptoResult, funcResult] = await Promise.all([deptoPromise, funcPromise]);

                    // 1. Popula o select de departamentos
                    if (deptoResult.status && deptoResult.departamentos) {
                        const select = document.getElementById('departamento');
                        deptoResult.departamentos.forEach(depto => {
                            select.innerHTML += `<option value="${depto._id}">${depto.nome}</option>`;
                        });
                    }

                    // 2. Preenche o formulário com os dados do funcionário
                    if (!funcResult.status || !funcResult.funcionario) {
                        throw new Error(funcResult.msg || 'Funcionário não encontrado.');
                    }

                    const func = funcResult.funcionario;
                    document.getElementById('nome').value = func.nome || '';
                    document.getElementById('email').value = func.email || '';
                    document.getElementById('CPF').value = func.CPF || '';
                    document.getElementById('telefone').value = func.telefone || '';
                    document.getElementById('turno').value = func.turno || 'Manhã';
                    document.getElementById('role').value = func.role || 'funcionario';
                    document.getElementById('dataNascimento').value = func.dataNascimento ? new Date(func.dataNascimento).toISOString().split('T')[0] : '';
                    document.getElementById('departamento').value = func.departamento ? func.departamento._id : '';

                    // 3. Preenche as permissões
                    // const permissoesContainer = document.getElementById('permissoes-container');
                    // permissoesContainer.innerHTML = '';
                    // todasAsPermissoes.forEach(p => {
                    //     const isChecked = func.permissoes && func.permissoes.includes(p.value);
                    //     permissoesContainer.innerHTML += `<div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" id="perm_${p.value}" name="permissoes" value="${p.value}" ${isChecked ? 'checked' : ''}><label class="form-check-label" for="perm_${p.value}">${p.label}</label></div>`;
                    // });

                } catch (error) {
                    exibirMensagem(`Erro ao carregar dados: ${error.message}`, 'erro');
                }
            }

            // Adiciona o listener ao formulário de edição
            const form = document.getElementById("form-editar");
            if (form) {
                form.addEventListener("submit", atualizarFuncionario);
            }

            // Inicia o carregamento dos dados
            carregarDadosFuncionario();
        });
       

    </script>
</body>
</html>