<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestão de Ordem de Produção</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/gestao-op.css" />
</head>
<body>
    <div class="container-fluid py-3">
        <div id="loading-spinner" class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
        </div>

        <div id="conteudo-pagina" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-secondary me-3 no-print" onclick="location.href = document.referrer;">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <div>
                        <h1 id="op-titulo" class="mb-0 fs-3">Ordem de Produção</h1>
                        <p class="text-muted mb-0 small">Acompanhe o progresso e gerencie as etapas.</p>
                    </div>
                </div>
                <div class="text-center no-print">
                     <button class="btn btn-light border" id="btn-qrcode-modal" title="Gerar Etiqueta QR Code">
                        <i class="bi bi-qr-code-scan fs-4"></i>
                    </button>
                </div>
            </div>

            <div class="printable-area">
                <div class="row mb-3 d-none d-print-flex align-items-center">
                    <div class="col-8">
                        <h2 id="op-titulo-print" class="fs-4"></h2>
                    </div>
                    <div class="col-4 text-end">
                        <div id="qrcode-container-print"></div>
                    </div>
                </div>


                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                        <h5 class="mb-0 fs-6">Detalhes da Ordem de Produção</h5>
                        <div class="no-print">
                            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                                <i class="bi bi-printer"></i> Imprimir OP
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <dl class="row mb-lg-0">
                                    <dt class="col-sm-4 text-muted fw-normal">Produto:</dt>
                                    <dd class="col-sm-8 fs-5 fw-semibold" id="op-produto"></dd>

                                    <dt class="col-sm-4 text-muted fw-normal">Quantidade:</dt>
                                    <dd class="col-sm-8" id="op-quantidade"></dd>
                                    
                                    <dt class="col-sm-4 text-muted fw-normal">Criado por:</dt>
                                    <dd class="col-sm-8" id="op-criado-por"></dd>
                                </dl>
                            </div>
                            <div class="col-lg-6">
                                <dl class="row mb-0">
                                    <dt class="col-sm-5 text-muted fw-normal">Data de Entrega:</dt>
                                    <dd class="col-sm-7" id="op-data-entrega"></dd>

                                    <dt class="col-sm-5 text-muted fw-normal">Tempo Médio:</dt>
                                    <dd class="col-sm-7" id="op-tempo-medio"></dd>

                                    <dt class="col-sm-5 text-muted fw-normal">Status:</dt>
                                    <dd class="col-sm-7"><span id="op-status"></span></dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header py-2">
                        <h5 class="mb-0 fs-6">Componentes Necessários</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Componente</th>
                                        <th>Código</th>
                                        <th>Quantidade</th>
                                    </tr>
                                </thead>
                                <tbody id="componentes-tabela"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <h3 class="mt-4 fs-5">Linha de Produção</h3>
                <div id="etapas-container" class="mt-3"></div>
            </div>
        </div>
    </div>
    
    <div class="modal fade" id="qrCodeLabelModal" tabindex="-1" aria-labelledby="qrCodeLabelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header no-print">
                    <h5 class="modal-title" id="qrCodeLabelModalLabel">Etiqueta de Identificação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="printable-label" class="text-center p-3 border rounded">
                        <h4 id="label-op-id" class="mb-1"></h4>
                        <p id="label-produto" class="lead fs-6"></p>
                        <div id="qrcode-container-modal" class="d-flex justify-content-center my-3"></div>
                        <p class="mb-0"><strong>Qtd:</strong> <span id="label-quantidade"></span></p>
                        <p class="small text-muted">Digitalize para ver detalhes da OP</p>
                    </div>
                </div>
                <div class="modal-footer no-print">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-outline-primary" onclick="gerarPdfParaImpressao('qrcode')">
                        <i class="bi bi-qr-code"></i> Imprimir só QR Code
                    </button>
                    <button type="button" class="btn btn-primary" onclick="gerarPdfParaImpressao('etiqueta')">
                        <i class="bi bi-printer"></i> Imprimir Etiqueta Completa
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script src="/js/gestao-op.js"></script>
</body>
</html>