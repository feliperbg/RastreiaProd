<!doctype html>
<html lang="pt-BR">
<head>
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <title>Relatórios de Produção - RastreiaProd</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/adminlte.min.css" />
  
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <style>
    #loading-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(255, 255, 255, 0.8); z-index: 1050; display: flex;
        align-items: center; justify-content: center; border-radius: .25rem;
    }
    .small-box .icon {
        font-size: 60px;
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        padding: 0;
        left: auto;
    }
    .small-box h3 { font-size: 2rem; }

    .small-box .btn-outline-light {
        border: none !important;
    }
    </style>
</head>

<body class="layout-fluid sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
    <%- include('../partials/header.ejs') %>
    <%- include('../partials/sidebar.ejs') %>

    <main class="app-main">
      <div class="app-content">
        <div class="container-fluid">
          
          <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2">Dashboard de Produção</h1>
            <button id="btn-generate-pdf" class="btn btn-danger">
              <i class="bi bi-file-earmark-pdf"></i> Gerar Relatório PDF
            </button>
          </div>

          <div class="card card-primary card-outline mb-4">
              <div class="card-header">
                  <h3 class="card-title"><i class="bi bi-funnel"></i> Filtros de Análise</h3>
              </div>
              <div class="card-body">
                  <div class="row g-3">
                      <div class="col-md-5">
                          <label for="daterange" class="form-label">Período:</label>
                          <input type="text" class="form-control" id="daterange">
                      </div>
                      <div class="col-md-4">
                          <label for="filter-produto" class="form-label">Produto:</label>
                          <select class="form-select" id="filter-produto">
                              <option value="todos" selected>Todos os produtos</option>
                              <% produtos.forEach(p => { %>
                                  <option value="<%= p._id %>"><%= p.nome %></option>
                              <% }); %>
                          </select>
                      </div>
                      <div class="col-md-3 d-flex align-items-end">
                          <button id="btn-apply-filters" class="btn btn-primary w-100">
                              <i class="bi bi-search"></i> Aplicar Filtros
                          </button>
                      </div>
                  </div>
              </div>
          </div>

          <div id="report-content" class="position-relative">
              <div id="loading-overlay" class="d-none">
                  <div class="spinner-border text-primary" role="status">
                      <span class="visually-hidden">Carregando...</span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-lg-3 col-6">
                    <div class="small-box bg-info position-relative">
                      <div class="inner ps-3">
                        <h3 id="kpi-oee">0%</h3>
                        <p>OEE Geral</p>
                      </div>
                      <div class="icon"><i class="bi bi-speedometer2"></i></div>
                      <button class="btn btn-sm btn-outline-light position-absolute top-0 end-0 m-2" data-kpi="oee" data-bs-toggle="modal" data-bs-target="#kpiModal" title="O que é isso?">
                        <i class="bi bi-info-circle"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-lg-3 col-6">
                    <div class="small-box position-relative" style="background-color: #0d6efd; color: white;">
                      <div class="inner ps-3">
                        <h3 id="kpi-disponibilidade">0%</h3>
                        <p>Disponibilidade</p>
                      </div>
                      <div class="icon"><i class="bi bi-clock-history"></i></div>
                      <button class="btn btn-sm btn-outline-light position-absolute top-0 end-0 m-2" data-kpi="disponibilidade" data-bs-toggle="modal" data-bs-target="#kpiModal" title="O que é isso?">
                        <i class="bi bi-info-circle"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-lg-3 col-6">
                    <div class="small-box position-relative" style="background-color: #198754; color: white;">
                      <div class="inner ps-3">
                        <h3 id="kpi-qualidade">0%</h3>
                        <p>Qualidade</p>
                      </div>
                      <div class="icon"><i class="bi bi-patch-check"></i></div>
                      <button class="btn btn-sm btn-outline-light position-absolute top-0 end-0 m-2" data-kpi="qualidade" data-bs-toggle="modal" data-bs-target="#kpiModal" title="O que é isso?">
                        <i class="bi bi-info-circle"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-lg-3 col-6">
                    <div class="small-box position-relative" style="background-color: #6c757d; color: white;">
                      <div class="inner ps-3">
                        <h3 id="kpi-performance">0%</h3>
                        <p>Performance</p>
                      </div>
                      <div class="icon"><i class="bi bi-rocket-takeoff"></i></div>
                      <button class="btn btn-sm btn-outline-light position-absolute top-0 end-0 m-2" data-kpi="performance" data-bs-toggle="modal" data-bs-target="#kpiModal" title="O que é isso?">
                        <i class="bi bi-info-circle"></i>
                      </button>
                    </div>
                  </div>
              </div>

              <div class="row">
                  <div class="col-lg-7">
                      <div class="card h-100">
                          <div class="card-header bg-dark text-white">Evolução do OEE no Período</div>
                          <div class="card-body" style="min-height: 300px;"><canvas id="oeeEvolutionChart"></canvas></div>
                      </div>
                  </div>
                  <div class="col-lg-5">
                      <div class="card h-100">
                          <div class="card-header bg-warning text-dark">Principais Causas de Parada (Pareto)</div>
                          <div class="card-body" style="min-height: 300px;"><canvas id="paretoChart"></canvas></div>
                      </div>
                  </div>
              </div>
              <div class="row mt-4">
                  <div class="col-12">
                       <div class="card h-100">
                          <div class="card-header bg-success text-white">Produção por Produto (Top 7)</div>
                          <div class="card-body" style="min-height: 300px;"><canvas id="productionChart"></canvas></div>
                      </div>
                  </div>
              </div>
            </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <!-- Modal de Explicação do KPI (movido para fora do #report-content) -->
    <div class="modal fade" id="kpiModal" tabindex="-1" aria-labelledby="kpiModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="kpiModalLabel">Explicação do KPI</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="kpiModalBody"></div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/adminlte.min.js"></script>
  <script src="/js/toast.js"></script>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  
  <script src="https://cdn.jsdelivr.net/npm/moment/min/moment.min.js"></script>
  
  <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
  
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script src="/js/relatorio-pdf-generator.js"></script>
<script src="/js/relatorios.js"></script>


</body>
</html>